{
  "name": "@goodandready/dsh-usage-guard",
  "version": "0.1.0",
  "description": "Keeps a malformed token-usage sample from taking a whole session history down with it: a missing or non-numeric counter becomes zero before the harness adds it up, so the fold never yields NaN and already-broken sessions open again.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "token-usage",
    "session-history",
    "patch"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GooDAnDReaDY/dsh-usage-guard.git"
  },
  "homepage": "https://github.com/GooDAnDReaDY/dsh-usage-guard",
  "bugs": {
    "url": "https://github.com/GooDAnDReaDY/dsh-usage-guard/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
